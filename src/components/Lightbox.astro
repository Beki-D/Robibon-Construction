---
import Icon from './Icon.astro'
---

<dialog class="lightbox" id="lightbox" aria-label="Project photos">
  <div class="lightbox__stage"><img class="lightbox__img" alt="" /></div>
  <p class="lightbox__caption"></p>
  <button class="lightbox__btn lightbox__btn--close" type="button" aria-label="Close"><Icon name="close" /></button>
  <button class="lightbox__btn lightbox__btn--prev" type="button" aria-label="Previous photo"><Icon name="prev" /></button>
  <button class="lightbox__btn lightbox__btn--next" type="button" aria-label="Next photo"><Icon name="next" /></button>
</dialog>
