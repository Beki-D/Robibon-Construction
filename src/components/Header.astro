---
import { NAV, SITE } from '../config/site'

interface Props {
  path: string
}

const { path } = Astro.props
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href))
---

<header class="header" id="header">
  <div class="header__bar">
    <a href="/" class="header__brand" aria-label="ROBIBON Construction home">
      <span class="logo header__logo"></span>
      <span class="header__name"><span>Robibon</span><small>Construction</small></span>
    </a>

    <nav class="header__nav" aria-label="Main">
      {NAV.map((item) => (
        <a class="header__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <button class="menu-toggle" id="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-overlay" aria-label="Open menu">
      <span class="menu-toggle__icon"><span></span><span></span><span></span></span>
    </button>
  </div>
</header>

<div class="menu-overlay" id="menu-overlay">
  <nav class="menu-overlay__links" aria-label="Mobile">
    {NAV.map((item) => (
      <a class="menu-overlay__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>
  <div class="menu-overlay__contact">
    <a href={SITE.phone.href}>{SITE.phone.display}</a>
    <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    <span>{SITE.address}</span>
  </div>
</div>
